PORT=5000
NODE_ENV=production
MONGO_URI=your_mongodb_atlas_connection_string
JWT_SECRET=your_jwt_secret_key
# Comma-separated list of allowed frontend origins (no trailing slash)
CLIENT_URL=https://your-app.vercel.app,http://localhost:5173
AI_SERVICE_URL=https://your-ai-service.onrender.com

# Twilio SMS (optional — SMS is skipped if these are missing)
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_twilio_auth_token
# Either a Twilio number (E.164) or a Messaging Service SID
TWILIO_PHONE_NUMBER=+15551234567
# TWILIO_MESSAGING_SERVICE_SID=MGxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Prefix for phone numbers saved without a country code
SMS_DEFAULT_COUNTRY_CODE=+91
# Max SMS per notification (cost guard) and radius for alert SMS
SMS_MAX_RECIPIENTS=100
SMS_ALERT_RADIUS_KM=5
